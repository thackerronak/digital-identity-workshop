# ── Versions ────────────────────────────────────────────────────────────────
KEYCLOAK_VERSION=26.6.0

# ── Keycloak ────────────────────────────────────────────────────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
KC_REALM=workshop

# Frontend URL: what the BROWSER uses. Must stay localhost.
KC_PUBLIC_URL=http://keycloak.localhost:8080

# Backchannel host: what CONTAINERS use to reach Keycloak (compose DNS name).
# The credential offer carries this, because only wallet-api ever fetches it.
# (obsolete: one hostname now works from browser AND containers)

# ── Demo employees (seeded, password identical for all) ─────────────────────
DEMO_PASSWORD=workshop

# ── Portal (verifier) ───────────────────────────────────────────────────────
APP_PUBLIC_URL=http://portal.localhost:3000
# (obsolete: portal.localhost:3000 resolves from both sides too)
