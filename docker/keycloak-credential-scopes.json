[
  {
    "name": "employee-badge",
    "description": "Google employee badge, issued as an SD-JWT VC",
    "protocol": "oid4vc",
    "attributes": {
      "vc.credential_configuration_id": "employee-badge",
      "vc.format": "dc+sd-jwt",
      "vc.verifiable_credential_type": "https://workshop.acme.test/employee-badge",
      "vc.credential_signing_alg": "ES256",
      "vc.expiry_in_seconds": "31536000",
