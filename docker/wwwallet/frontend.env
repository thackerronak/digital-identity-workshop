# Consumed at CONTAINER START by wwWallet's /docker-entrypoint.d/wallet-config.sh,
# which runs config/_cli_.ts to inject these into index.html. They are runtime
# values, not build args -- changing them needs only a container recreate.

WALLET_NAME=Your Wallet
WALLET_TAGLINE=Workshop demo

# Backend + passkey origin. WebAuthn requires a secure context; localhost counts.
WALLET_BACKEND_URL=http://localhost:8002
WS_URL=ws://localhost:8002
WEBAUTHN_RPID=localhost
OPENID4VCI_REDIRECT_URI=http://localhost:3001/
STATIC_PUBLIC_URL=http://localhost:3001

DID_KEY_VERSION=jwk_jcs-pub
DISPLAY_CONSOLE=true
DEV_MODE=true

# Keycloak advertises only the `jwt` proof type, so prefer it over attestation.
OPENID4VCI_PROOF_TYPE_PRECEDENCE=jwt

# Local demo: no trust-anchor registry, no DNS SAN checks, no VCT registry.
VALIDATE_CREDENTIALS_WITH_TRUST_ANCHORS=false
OPENID4VP_SAN_DNS_CHECK=false
OPENID4VP_SAN_DNS_CHECK_SSL_CERTS=false
MULTI_LANGUAGE_DISPLAY=true
DISPLAY_ISSUANCE_WARNINGS=true
DISPLAY_CREDENTIAL_USAGES=true
SHOW_PWA_INSTALL_PROMPT=false
FOLD_EVENT_HISTORY_AFTER_SECONDS=2592000
OPENID4VCI_MAX_ACCEPTED_BATCH_SIZE=10
OPENID4VCI_TRANSACTION_ID_POLLING_INTERVAL_IN_SECONDS=5
OPENID4VCI_TRANSACTION_ID_LIFETIME_IN_SECONDS=2592000
